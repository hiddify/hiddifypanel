# Vite dev server (open this in the browser)
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=9000

# Flask backend — Vite proxies API + legacy /admin to this port
VITE_API_TARGET=http://127.0.0.1:9001

# Vite base is auto-resolved via: python -m hiddifypanel get-setting proxy_path_admin
# (reads /opt/hiddify-manager/current.json; override with HIDDIFY_CURRENT_JSON)

# Optional overrides:
# VITE_PROXY_PATH=your-proxy-path
# VITE_DEV_BASE=/your-proxy-path/admin/v2/

# Optional API base override:
# VITE_API_BASE=/{your-proxy-path}/api/v2/admin/
