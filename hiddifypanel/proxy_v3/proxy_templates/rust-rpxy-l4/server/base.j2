{# rust-rpxy-l4 server base — TLS/QUIC SNI gateway to local proxy ports #}

{#- Always 443: a domain's own TLS port reaches it through the firewall's redirect (redirect_domain_ports); the old
    tls_ports setting (hidden) is not read any more. #}
listen_port = 443
listen_ipv6 = {{ 'true' if ctx.hconfig.ipv6_enabled else 'false' }}
tcp_backlog = 4096
tcp_max_connections = 8192
udp_max_connections = 2048
tcp_send_proxy_protocol = "v2"
tcp_protocol_detection_timeout_msec=1000

udp_target = ["127.0.0.1:902"]
{#- untyped streams: HAProxy finds the SNI proxies that rpxy-l4 misses (haproxy/server/fronts/untyped_tls) #}
tcp_target = ["127.0.0.1:903"]

[protocols."quic_service"]
protocol = "quic"
target = ["127.0.0.1:902"]


[protocols."tls_service"]
protocol = "tls"
target = ["127.0.0.1:901"]





{% if ctx.hconfig.ssh_server_enable and ctx.hconfig.ssh_use_tls_port %}
[protocols."ssh_service"]
protocol = "ssh"
target = ["127.0.0.1:{{ctx.hconfig.ssh_server_port}}"]
{% endif %}

{% if ctx.hconfig.wireguard_enable and ctx.hconfig.wireguard_use_quic_port %}
[protocols."wireguard_service"]
protocol = "wireguard"
target = ["127.0.0.1:{{ctx.hconfig.wireguard_port}}"]
idle_lifetime = 30
{% endif %}

{#- ShadowTLS, SS FakeTLS and Telegram MTProxy are SNI proxies: routed by their own domains in the SNI gateway section below. #}

############## SNI gateway (domains_sni_gateway) ##############
{% for p in ctx.proxies if p.mode == "domains_sni_gateway" %}
{% for pd in p.iter_proxies_with_domain() %}

{% if pd.tcp_udp !="udp" and pd.tcp_port %}
[protocols."sp_{{ p.id }}_{{ pd.domain.name|slugify }}_tls"]
protocol = "tls"
server_names = ["{{ pd.domain.sni }}"]
target = ["127.0.0.1:{{ pd.tcp_port }}"]
{% endif %}

{% if pd.tcp_udp !="tcp" and pd.udp_port %}
[protocols."sp_{{ p.id }}_{{ pd.domain.name|slugify }}_quic"]
protocol = "quic"
server_names = ["{{ pd.domain.sni }}"]
target = ["127.0.0.1:{{ pd.udp_port }}"]
{% endif %}

{% endfor %}
{% endfor %}


############## end of SNI gateway ##############
