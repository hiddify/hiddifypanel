{"tag": "freedom", "protocol": "freedom"},
{"tag": "direct", "protocol": "freedom"},
{"tag": "WARP", "protocol": "freedom", "streamSettings": {"sockopt": {"tcpFastOpen": true, "interface": "warp"}}},
{"tag": "blackhole", "protocol": "blackhole"},
{# SOCKS outbounds from the Outbound manager; Tor / Psiphon and the admin's hiddify-core outbounds / endpoints
   (run by hiddify-core) are reached on its local SOCKS inbounds #}
{% for o in ctx.outbounds.xray_socks %}
{
  "tag": "{{ o.xray_tag }}",
  "protocol": "socks",
  "settings": {
    "address": "{{ o.host }}",
      "port": {{ o.port }},
      {% if o.username %}
        "user": {{ o.username|tojson }},
        "pass": {{ o.password|tojson }},
      {% endif %}
  },
},
{% endfor %}
{# The admin's own xray outbounds (Outbounds → xray outbound); routing uses their tags #}
{% for entry in ctx.outbounds.xray_raw_outbounds %}
{{ entry|tojson }},
{% endfor %}
{"tag": "DNS-Internal", "protocol": "dns"}
