{#This special config, will only responsible for terminating reality connection and the rest will be handled by haproxy gateway similar to the other configs.#}
{% block inbounds %}
    {% for ctx in ctx.iter_ctx_domains() %}
        {
            "tag": "reality terminator {{ctx.proxy.id}} {{ctx.proxy.tag}} {{ctx.proxy.domain.name}}",
            "listen":"127.0.0.1",
            "port": {{ ctx.proxy.tcp_port }}, 
            "protocol": "vless",
            "settings": {
                "clients": [
                    {% for u in ctx.users %}
                    {
                    "id": "{{ u.uuid }}",
                    "email": "{{ u.uuid }}",
                    {# Vision only when configured; clients connect here directly over REALITY+TCP. #}
                    {% if ctx.hconfig.vless_flow %}"flow": "{{ ctx.hconfig.vless_flow }}",{% endif %}
                    },
                    {% endfor %}
                ],

                {# xray rejects "decryption" together with "fallbacks": raw VLESS clients here use encryption none #}
                "decryption": "none",
                {# Not VLESS: the Trojan inbound of the same ALPN below serves raw Trojan over REALITY and passes the
                   rest on to the gateway (Trojan clients offer h2 as well, so ALPN alone can not tell them apart). #}
                "fallbacks": [
                    {
                        "alpn": "h2",
                        "dest": "@@trojan_in_reality_h2_{{ ctx.proxy.id }}_{{ ctx.proxy.domain.name|slugify }}",
                        "xver":2
                    },
                    {
                        "dest": "@@trojan_in_reality_h1_{{ ctx.proxy.id }}_{{ ctx.proxy.domain.name|slugify }}",
                        "xver":2
                    },
                ]
            },
            "streamSettings": {  
                "tcpSettings": {
                    "acceptProxyProtocol": true
                },
                "security": "reality",
                "realitySettings": {
                    "show": false, 
                    "target": "{{ ctx.proxy.domain.sni }}:443", 
                    "serverNames": [ "{{ ctx.proxy.domain.sni }}"],
                    "privateKey": "{{ ctx.hconfig.reality_private_key }}", 
                    "shortIds": [ 
                        "", 
                        {% for sid in (ctx.hconfig.reality_short_ids or '').split(',') %}
                        "{{ sid }}",
                        {% endfor %}
                    ],
                    //"mldsa65Seed": "", //TODO: Optional: Run `./xray mldsa65` to generate an additional post-quantum signature for the certificate.
                }
            }
        },
        {# This domain's Trojan inbounds: the socket names hold the domain, each terminator has its own #}
        {% for alpn, gateway in (("h2", "@@http_in_h2"), ("h1", "@@tcp_in_reality_h1")) %}
        {
            "tag": "reality trojan {{ alpn }} {{ctx.proxy.id}} {{ctx.proxy.tag}} {{ ctx.proxy.domain.name }}",
            "listen": "@@trojan_in_reality_{{ alpn }}_{{ ctx.proxy.id }}_{{ ctx.proxy.domain.name|slugify }}",
            "protocol": "trojan",
            "settings": {
                "clients": [
                    {% for u in ctx.users %}
                    {"password": "{{ u.uuid }}", "email": "{{ u.uuid }}"},
                    {% endfor %}
                ],
                "fallbacks": [
                    {"dest": "{{ gateway }}", "xver": 2}
                ]
            },
            "streamSettings": {
                "network": "tcp",
                "tcpSettings": {
                    "acceptProxyProtocol": true
                },
                "security": "none"
            }
        },
        {% endfor %}

    {% endfor %}
{% endblock %} 