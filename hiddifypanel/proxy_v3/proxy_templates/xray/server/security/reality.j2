"security": "reality",
"realitySettings": {
  "show": false,
  "dest": "{{ ctx.domain.sni }}:443",
  "xver": 0,
  "serverNames": ["{{ ctx.domain.sni }}"],
  "privateKey": "{{ ctx.hconfig.reality_private_key }}",
  "shortIds": [
    "",
    {% for sid in (ctx.hconfig.reality_short_ids or '').split(',') if sid.strip() %}
    "{{ sid.strip() }}",
    {% endfor %}
  ]
}
