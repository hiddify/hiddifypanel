{# VLESS without encryption over plain HTTP sends everything in clear: never offered #}
{{ skip("VLESS without encryption over plain HTTP") if ctx.proxy.tls_layer == "http" and not (ctx.proxy.server_core == "xray" and ctx.hconfig.vless_encryption) }}
"protocol": "vless",
"settings": {
  "vnext": [{
    "address": "{{ ctx.proxy.server }}",
    "port": {{ ctx.proxy.port }},
    "users": [{
      "id": "{{ ctx.user.uuid }}",
      {# Xray rejects a VLESS user without an explicit encryption; only an xray server can terminate a real one. #}
      {# raw VLESS on a REALITY domain ends at the reality termination, which can not use encryption #}
      {% set reality_terminated = ctx.proxy.transport == "tcp" and ctx.proxy.domain.is_reality() %}
      {% set has_encryption = ctx.proxy.server_core == 'xray' and ctx.hconfig.vless_encryption and not reality_terminated %}
      "encryption": "{{ ctx.hconfig.vless_encryption if has_encryption else 'none' }}",
      {# Vision only on TCP+REALITY (matches reality_termination.j2); never on WS/gRPC/XHTTP (#5640). #}
      {% if ctx.proxy.server_core == "xray" and ctx.hconfig.vless_flow and reality_terminated %}
        "flow": "{{ ctx.hconfig.vless_flow }}",
      {% endif %}
      "level": 8
    }]
  }]
}
