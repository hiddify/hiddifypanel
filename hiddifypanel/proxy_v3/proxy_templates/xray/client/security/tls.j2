{% set domain = domain if domain is defined else ctx.proxy.domain %}
{% set tls_layer = (tls_layer if tls_layer else ctx.proxy.tls_layer) or 'http' %}
{% if tls_layer == 'http' %}
  "security": "none",
{% elif domain.is_reality() %}
  "security": "reality",
  "realitySettings": {
    "serverName": "{{ domain.sni }}",
    "fingerprint": "{% if ctx.hconfig.utls and ctx.hconfig.utls != 'none' %}{{ ctx.hconfig.utls }}{% else %}chrome{% endif %}",
    "shortId": "{{ ctx.hconfig.reality_short_ids | choose_random }}",
    "publicKey": "{{ ctx.hconfig.reality_public_key }}",
    "show": false
  },
{% else %}
  "security": "tls",
  "tlsSettings": {
    "serverName": "{{ domain.sni }}",
    {%if domain.allow_insecure %}
      {%if ctx.platform.xray.version>"0.0.0" and ctx.platform.xray.version<"26.1.1" %}
        "allowInsecure": true,
      {%else%}
        "pinnedPeerCertSha256": "{{",".join(domain.cert.pinnedPeerCertSha256)}}",
      {%endif%}
    {%endif%}
    {# Xray's chrome hello (also the default when none is set) offers h2 whatever "alpn" says: a CDN then answers an
       HTTP/1.1-only xhttp leg in HTTP/2. Xray's "android" hello sends the configured ALPN. #}
    {% set h1_xhttp = ctx.proxy.transport == "xhttp" and tls_layer == "tls_h1" and domain.mode == "cdn"%}
    {% if tls_layer not in ["quic_tls", "quic_tcp_tls"] and (h1_xhttp or (ctx.hconfig.utls and ctx.hconfig.utls != 'none')) %}
      "fingerprint": "{{ 'android' if h1_xhttp else ctx.hconfig.utls }}",
    {% endif %}

    
    "alpn": {{ tls_layer.alpns() | tojson }},
    {% if domain.extra.ech_config %}
    "echConfigList": "{{ domain.extra.ech_config }}",
    {% elif domain.ech and domain.echinfo %}
    "echConfigList": "{{ domain.echinfo }}",
    {% endif %}
  },
{% endif %}

