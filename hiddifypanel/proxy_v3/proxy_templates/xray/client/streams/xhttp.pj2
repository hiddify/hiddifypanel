"network": "xhttp",
"xhttpSettings": {
  "mode": "{{ mode|default('auto') }}",
  "path": "/{{ proxy.path }}",
  "host": "{{ proxy.domain.host }}",
  "extra": {
    {% if proxy.domain.download %}
    "downloadSettings": {
      "address": "{{ proxy.domain.download.server() }}",
      "port": {{ proxy.domain.download.port or proxy.tcp_port }},
      "network": "xhttp",
      "security": {% if download_tls %}"tls"{% else %}"none"{% endif %},
      {% if download_tls %}
      "tlsSettings": {
        "serverName": "{{ proxy.domain.download.sni or proxy.domain.sni }}",
        {%if proxy.domain.download.allow_insecure%}
        "allowInsecure": true,
        {%endif%}
        "fingerprint": "{{ ctx.hconfig.fingerprint }}",
        {%if download_alpns%}
          "alpn": {{ download_alpns | tojson }}
        {%endif%}
      },
      {% endif %}
      "xhttpSettings": {
        "path": "/{{ proxy.path }}",
        "host": "{{ proxy.domain.download.host }}",
        "mode": "{{ mode|default('auto') }}"
      }
    },
    {% endif %}
    "scMaxEachPostBytes": {{ sc_max_each_post|default(1000000) }},
    "scMinPostsIntervalMs": {{ sc_min_posts_interval|default(30) }},
    "xmux": {
      "maxConcurrency": {{ xmux_max_concurrency|default('"16-32"') }},
      "maxConnections": {{ xmux_max_connections|default(0) }},
      "cMaxReuseTimes": {{ xmux_c_max_reuse|default(0) }},
      "hMaxRequestTimes": {{ xmux_h_max_request|default('"600-900"') }},
      "hMaxReusableSecs": {{ xmux_h_max_reusable|default('"1000-2000"') }},
      "hKeepAlivePeriod": {{ xmux_h_keepalive|default(0) }}
    }
  }
},
