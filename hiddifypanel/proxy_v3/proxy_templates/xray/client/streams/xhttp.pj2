"network": "xhttp",
"xhttpSettings": {
  "mode": "{{ mode|default('auto') }}",
  "path": "/{{ proxy.path }}",
  "host": "{{ proxy.domain.host }}",
  "extra": {
    {% if proxy.is_download_upload_different() or alpns != download_alpns %}

    "downloadSettings": {
      "address": "{{ proxy.domain.download.server() }}",
      "port": {{ proxy.domain.download.port or proxy.download_port }},
      "network": "xhttp",
      {% with domain=proxy.domain.download, alpns=download_alpns, tls_layer=proxy.download_tls_layer %}
        {% include 'xray/client/security/tls' %}
      {% endwith %}
      "xhttpSettings": {
        "path": "/{{ proxy.path }}",
        "host": "{{ proxy.domain.download.host }}",
        "mode": "{{ mode|default('auto') }}"
      }
    },
    {% endif %}
    
  }
},
