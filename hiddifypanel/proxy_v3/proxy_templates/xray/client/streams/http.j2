"network": "tcp",
"tcpSettings": {
  "header": {
    "type": "http",
    "request": {
      "path": ["/{{ proxy.path }}"],
      {#- the browser-like headers that xray's server can read: see rawhttp_headers -#}
      {%- set headers %}{"Host": ["{{ proxy.domain.host }}"], {% include 'xray/client/default_headers' %}}{% endset %}
      "headers": {{ rawhttp_headers(headers, "/" ~ proxy.path)|tojson }}
    }
  }
},
