{#- rawhttp's fake request header: xray's server reads it in one go and rejects one that comes in two pieces
    ("malformed MIME header: missing colon"); a long, browser-like header often did (1 in 2 to 9 in 10 connections
    failed), so it stays short. -#}
"User-Agent": ["{{ctx.hconfig.default_useragent_string}}"],
"Accept": ["*/*"],
"Connection": ["keep-alive"]
