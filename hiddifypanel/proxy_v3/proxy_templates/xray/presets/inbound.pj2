{% block inbound %}
{
  {% include 'xray/inbound/listen' %},
  {% include '__PROTO_SLUG__' %},
  "streamSettings": {
    {% if custom_path %}
    {% set PATH = custom_path[1:] if custom_path.startswith('/') else custom_path %}
    {% else %}
    {% set PATH = hconfigs.path___PROTO_KEY__ ~ hconfigs.path___TRANSPORT_KEY__ %}
    {% endif %}
    __FLOW_LINE__
    {% include '__STREAM_SLUG__' %},
    {% include '__SECURITY_SLUG__' %},
    {% include 'xray/snippets/stream_sockopt' %}
  },
  {% include 'xray/snippets/sniffing' %}
}
{% endblock %}
