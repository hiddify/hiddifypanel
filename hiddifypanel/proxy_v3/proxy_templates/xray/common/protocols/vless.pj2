"protocol": "vless",
"settings": {
  "clients": [
    {% for u in ctx.users %}
    {
      "id": "{{ u.uuid }}",
      "email": "{{ u.uuid }}@hiddify.com",
      "flow": "{% if ctx.proxy.is_reality and ctx.proxy.transport == 'tcp' %}{{ ctx.hconfig.vless_flow or 'xtls-rprx-vision' }}{% else %}{{ ctx.hconfig.vless_flow }}{% endif %}"
    },
    {% endfor %}
  ],
  "decryption": "none",
  "fallbacks": [
    {
      "dest": "@@http_in_h2",
      "xver": 2
    }
  ]
}
