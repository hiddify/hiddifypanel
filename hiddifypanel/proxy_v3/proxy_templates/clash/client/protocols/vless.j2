{# Mihomo VLESS — field map: https://shipengtao.com/en/tools/vless-to-clash/
   Encryption: same gate as sublink (xray server only; reality TCP terminator cannot use it).
   Mihomo has it since 1.19.14, on every transport: 1.19.32 against Xray 26.3 connects over raw, ws,
   httpupgrade, grpc and xhttp (and the same server refuses it without encryption). #}
{% set reality_terminated = ctx.proxy.transport == "tcp" and ctx.proxy.domain.is_reality() %}
{% set encryption = 'none' if reality_terminated or ctx.proxy.server_core != "xray" else (ctx.hconfig.vless_encryption or 'none') %}
{{ skip("VLESS encryption needs Mihomo ≥ 1.19.14") if encryption and encryption != "none" and ctx.platform.app_group == "clash" and ctx.platform.app.version > "0.0.0" and ctx.platform.app.version < "1.19.14" }}
"type": "vless",
"server": "{{ proxy.server }}",
"port": {{ ctx.proxy.port }},
"uuid": "{{ ctx.user.uuid }}",
"udp": true,
"packet-encoding": "xudp",
{% if encryption and encryption != "none" %}
"encryption": "{{ encryption }}",
{% endif %}
{% if ctx.proxy.server_core == "xray" and ctx.hconfig.vless_flow and ctx.proxy.transport == "tcp" %}
"flow": "{{ ctx.hconfig.vless_flow }}",
{% endif %}
