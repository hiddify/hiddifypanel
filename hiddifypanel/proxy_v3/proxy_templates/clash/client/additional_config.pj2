{#
  Builtin additional_config (clash / mihomo).
  Expects each URL to return JSON with a top-level "proxies" array
  (or a Clash YAML document when content_type is yaml).
  Disabled by default — enable the "Additional Config" custom proxy and edit URLs.
#}
{% set additional_configs = download(
     "json",
     "1h",
     "https://example.com/clash/" ~ ctx.user.uuid,
     "https://example2.com/clash/" ~ ctx.user.uuid
) %}
{% for conf in additional_configs if conf %}
  {% for proxy in conf.get("proxies", []) %}
   {{ proxy | tojson }},
  {% endfor %}
{% endfor %}
