{# Mihomo models HTTPUpgrade as WebSocket + v2ray-http-upgrade (wiki.metacubex.one transport).
   Against Xray httpupgrade inbounds this still fails in Mihomo 1.19.x (A/B: plain ws OK,
   same proxy with v2ray-http-upgrade flags fails; Xray client OK). HC (hiddify-core) can work. #}
{{ skip("httpupgrade_enable = " ~ ctx.hconfig.httpupgrade_enable) if not ctx.hconfig.httpupgrade_enable }}
{{ skip("Mihomo httpupgrade fails against Xray httpupgrade; use an Xray client") if ctx.proxy.server_core == "xray" }}
"network": "ws",
"ws-opts": {
  "path": "/{{ proxy.path }}",
  "headers": {
    "Host": "{{ proxy.domain.host }}"
  },
  "v2ray-http-upgrade": true,
  "v2ray-http-upgrade-fast-open": true
},
