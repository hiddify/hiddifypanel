{% for ctx in ctx.iter_ctx_domains() %}
{%set tag%}{%- include 'clash/client/tag' -%}{%endset%}
{
  "name": "{{tag|trim_no_line}}",
  "type": "__PROTO__",
  "server": "{{ ctx.proxy.server }}",
  "port": {{ ctx.proxy.tcp_port or ctx.proxy.udp_port }},
  "uuid": "{{ ctx.user.uuid }}",
  "network": "__NETWORK__",
  "tls": {{ ctx.proxy.uses_tls|tojson }},
  "servername": "{{ ctx.proxy.domain.sni }}",
  "udp": true,
  {% if ctx.proxy.transport == 'http' %}
  "http-opts": {
    "path": ["/{{ ctx.proxy.path }}"],
    "headers": {
      "Host": ["{{ ctx.proxy.domain.host }}"]
    }
  }{% endif %}
},
{% endfor %}
