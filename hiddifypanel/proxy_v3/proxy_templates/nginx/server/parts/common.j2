location /{{ ctx.hconfig.proxy_path_client }}/generate_204 {
  return 204;
}


if ($request_uri ~ "^/{{ ctx.hconfig.proxy_path_client }}/redirect/(.*)(%3A%2F%2F|://)(.*)$") {
  return 307 $1://$3;
}

location /{{ ctx.hconfig.proxy_path_admin }}/{{ ctx.hconfig.admin_secret }}/admin/stats/ {
	proxy_pass  http://localhost:8181/;
  sub_filter '="/' '="';
  sub_filter_once off;
	error_page 301 302 307 = @handle_redirect;
}

location /{{ ctx.hconfig.proxy_path_client }}/ghr/ {
  #for proxy github raw
  proxy_set_header Host raw.githubusercontent.com;
  set $upstream https://raw.githubusercontent.com:443/;
  proxy_pass $upstream;
}

location /{{ ctx.hconfig.proxy_path_client }}/gho/ {
  #for proxy github object
  proxy_set_header Host objects.githubusercontent.com;
  set $upstream https://objects.githubusercontent.com:443/;
  proxy_pass $upstream;
}

location /{{ ctx.hconfig.proxy_path_client }}/gh/ {
  #for proxy github
  resolver 8.8.8.8;
  proxy_set_header Host github.com;
  proxy_pass https://github.com:443/;
  proxy_redirect https://raw.githubusercontent.com/ https://$host/{{ ctx.hconfig.proxy_path }}/ghr/;
  proxy_redirect https://objects.githubusercontent.com/ https://$host/{{ ctx.hconfig.proxy_path }}/gho/;

  proxy_set_header Accept-Encoding "";
  sub_filter_once off;
  sub_filter    https://github.com/ /{{ ctx.hconfig.proxy_path }}/gh/;
  sub_filter    href="/ href="/{{ ctx.hconfig.proxy_path }}/gh/;
  sub_filter    src="/ src="/{{ ctx.hconfig.proxy_path }}/gh/;
}

location /{{ ctx.hconfig.proxy_path_client }}/dns/dns-query {
  set $upstream https://8.8.8.8/dns-query;
  proxy_pass $upstream$is_args$args;
}
location /{{ ctx.hconfig.proxy_path_client }}/speedtest/ {
  client_max_body_size 10000M;
  proxy_pass          http://localhost:438/;
}
location /{{ ctx.hconfig.proxy_path }}/static {
  include {{ include_path(ctx, 'nginx/server/parts/proxy_to_static') }};
}
location /{{ ctx.hconfig.proxy_path_client }}/static {
  include {{ include_path(ctx, 'nginx/server/parts/proxy_to_static') }};
}
location /{{ ctx.hconfig.proxy_path_admin }}/static {
  include {{ include_path(ctx, 'nginx/server/parts/proxy_to_static') }};
}



#Backward Compatibility
location /{{ ctx.hconfig.proxy_path }}/ {
  include {{ include_path(ctx, 'nginx/server/parts/proxy_to_panel') }};
}

location /{{ ctx.hconfig.proxy_path_client }}/ {
  include {{ include_path(ctx, 'nginx/server/parts/proxy_to_panel') }};
}

location /{{ ctx.hconfig.proxy_path_admin }}/ {
  client_max_body_size 10M;
  include {{ include_path(ctx, 'nginx/server/parts/proxy_to_panel') }};
}

location /{{ ctx.hconfig.proxy_path_admin }}/proxy-stats/ {
  proxy_pass http://localhost:16756/ui/;
}
location /{{ ctx.hconfig.proxy_path_admin }}/proxy-stats/api/ {
  proxy_pass http://localhost:16756/;
}
resolver 8.8.8.8;
