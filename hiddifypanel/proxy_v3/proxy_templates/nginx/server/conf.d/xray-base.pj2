# HTTP1 UDS listener
server {
    listen 127.0.0.1:501 proxy_protocol;
    listen unix:/opt/hiddify-manager/services/nginx/run/h1.sock proxy_protocol;
    server_name _;
    include {{ include_path(ctx, 'nginx/server/parts/hiddify') }};
    set_real_ip_from unix:;
    real_ip_header proxy_protocol;
}

# HTTP2 UDS listener
server {
    listen 127.0.0.1:502 proxy_protocol;
    listen unix:/opt/hiddify-manager/services/nginx/run/h2.sock proxy_protocol;
    http2 on;
    server_name _;
    set_real_ip_from unix:;
    real_ip_header proxy_protocol;
    include {{ include_path(ctx, 'nginx/server/parts/proxy_path') }};

    # Decoy website
    include {{ include_path(ctx, 'nginx/server/parts/hiddify') }};
}

server {
    listen unix:/opt/hiddify-manager/services/nginx/run/nginx_cdn_dispatcher.sock;
    set_real_ip_from unix:;
    real_ip_header "X-Real-IP";
    include {{ include_path(ctx, 'nginx/server/parts/proxy_path') }};
    # Decoy website
    include {{ include_path(ctx, 'nginx/server/parts/hiddify') }};
}

server {
    listen unix:/opt/hiddify-manager/services/nginx/run/nginx_cdn_dispatcher_h2.sock;
    http2 on;
    set_real_ip_from unix:;
    real_ip_header "X-Real-IP";
    include {{ include_path(ctx, 'nginx/server/parts/proxy_path') }};
    # Decoy website
    include {{ include_path(ctx, 'nginx/server/parts/hiddify') }};
}
