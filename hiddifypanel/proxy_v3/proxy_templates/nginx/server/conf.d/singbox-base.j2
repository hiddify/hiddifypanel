server {
    listen unix:/opt/hiddify-manager/services/nginx/run/grpc-singbox.sock proxy_protocol;
    http2 on;
    set_real_ip_from unix:;
    real_ip_header proxy_protocol;

    location /{{ ctx.hconfig.path_vless }}{{ ctx.hconfig.path_grpc }} {
        include {{ include_path(ctx, 'nginx/server/parts/grpc') }};
        grpc_pass 127.0.0.1:2023;
    }
    location /{{ ctx.hconfig.path_vmess }}{{ ctx.hconfig.path_grpc }} {
        include {{ include_path(ctx, 'nginx/server/parts/grpc') }};
        grpc_pass 127.0.0.1:2033;
    }
    location /{{ ctx.hconfig.path_ss }}{{ ctx.hconfig.path_grpc }} {
        include {{ include_path(ctx, 'nginx/server/parts/grpc') }};
        grpc_pass unix:/opt/hiddify-manager/services/xray/run/ssg.sock;
    }
    location /{{ ctx.hconfig.path_trojan }}{{ ctx.hconfig.path_grpc }} {
        include {{ include_path(ctx, 'nginx/server/parts/grpc') }};
        grpc_pass 127.0.0.1:2013;
    }
    include {{ include_path(ctx, 'nginx/server/parts/hiddify') }};
}
