{% set domain = domain or ctx.domain %}
"tls": {
  "enabled": true,
  "server_name": "{{ domain.sni }}",
  "reality": {
    "enabled": true,
    "handshake": {
      "server": "{{ domain.sni }}",
      "server_port": 443
    },
    "private_key": "{{ ctx.hconfig.reality_private_key }}",
    "short_id": [
      "",
      {% for sid in (ctx.hconfig.reality_short_ids or '').split(',') %}
      "{{ sid }}",
      {% endfor %}
    ],
    "max_time_difference": "2h"
  }
},
