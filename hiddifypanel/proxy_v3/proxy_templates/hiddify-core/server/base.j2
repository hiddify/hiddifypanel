{
  {% include 'hiddify-core/server/base/log' %},
  "inbounds": [
    {% include 'hiddify-core/server/base/builtin_inbounds' %},
    {% block inbounds %}{% endblock %}
  ],
  "outbounds": [
    {% include 'hiddify-core/server/base/outbounds' %},
  ],
  {# endpoints of a preset (e.g. WireGuard) come from the "endpoints" block; no section when there is none #}
  "endpoints": [
   {% if ctx.outbounds.singbox_raw_endpoints %}
    {% for entry in ctx.outbounds.singbox_raw_endpoints %}
    {{ entry|tojson }},
    {% endfor %}
   {% endif %}
   {% block endpoints %}{% endblock %}
    
  ],
  {% include 'hiddify-core/server/base/route' %},
  {% include 'hiddify-core/server/base/experimental' %},
  {% include 'hiddify-core/server/base/dns' %},
}
