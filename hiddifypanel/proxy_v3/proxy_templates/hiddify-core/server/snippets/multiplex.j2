{% if ctx.hconfig.mux_enable and False %}
,"multiplex": {
  "enabled": true,
  "padding": {% if ctx.hconfig.mux_padding_enable %}true{% else %}false{% endif %},
  "brutal": {
    "enabled": {% if ctx.hconfig.mux_brutal_enable %}true{% else %}false{% endif %},
    "up_mbps": {{ ctx.hconfig.mux_brutal_up_mbps }},
    "down_mbps": {{ ctx.hconfig.mux_brutal_down_mbps }}
  }
}
{% endif %}
