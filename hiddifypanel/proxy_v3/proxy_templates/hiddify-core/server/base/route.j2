{# Outbound manager (Admin → Outbounds): each outbound's sites and rule-sets, in rule order
   (block, SOCKS/Tor/Psiphon, WARP, direct); the default outbound is `final`. #}
"route": {
  "rule_set": [
    {% for rs in ctx.outbounds.rule_sets %}
    {
      "tag": "{{ rs.tag }}",
      "type": "remote",
      "format": {{ rs.format|tojson }},
      "update_interval": "1d",
      "url": {{ rs.url|tojson }}
    },
    {% endfor %}
  ],
  "final": "{{ ctx.outbounds.default_singbox_tag }}",
  "rules": [
    {"action": "sniff"},
    {
      "action": "hijack-dns",
      "port": [53]
    },
    {
      "action": "hijack-dns",
      "protocol": "dns"
    },
    {
      "protocol": "quic",
      "port": [443],
      "action": "reject",
      "method": "default"
    },
    {% set outbound_users = namespace(uuids=[]) %}
    {% for u in ctx.users if u.extra.get("outbound") %}
      {% if outbound_users.uuids.append(u.uuid) %}{% endif %}
    {% endfor %}
    {% if outbound_users.uuids %}
    {% for tag in ["WARP", "direct"] %}
      {
        "auth_user": {{ outbound_users.uuids|tojson }},
        "outbound":"{{ tag }}",

      },
    {% endfor %}
    {% endif %}
    {% for o in ctx.outbounds.items if o.has_singbox_rules %}
    {% set target %}{% if o.mode == 'block' %}"action": "reject", "method": "default"{% else %}"outbound": {{ o.singbox_tag|tojson }}{% endif %}{% endset %}
    {% if o.sites %}
    {
      {{ target }},
      "domain_suffix": {{ o.sites|tojson }}
    },
    {% endif %}
    {% if o.rule_sets %}
    {
      {{ target }},
      "rule_set": [{% for rs in o.rule_sets %}{{ rs.tag|tojson }},{% endfor %}]
    },
    {% endif %}
    {% endfor %}
    {
      "action": "reject",
      "ip_is_private": true
    }
  ]
}
