"type": "mieru",
"portBindings": [
  {% for protocol,ports in [("TCP",ctx.proxy.tcp_port_ranges),("UDP",ctx.proxy.udp_port_ranges)] %}
  {% for entry in ports %}
  {
    "protocol": "{{protocol}}",
    {% if entry is number %}
    "port": {{ entry }}
    {% else %}
    "portRange": "{{ entry }}"
    {% endif %}
  },
  {% endfor %}
  {% endfor %}
],
"users": [
  {% for user in ctx.users %}
  {
    "username": "{{ user.uuid }}", 
    "password": "h"
  },
  {% endfor %}
]
