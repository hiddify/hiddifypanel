
"type": "hysteria2",
"up_mbps": {{ ctx.hconfig.hysteria_up_mbps }},
"down_mbps": {{ ctx.hconfig.hysteria_down_mbps }},

{% if ctx.hconfig.hysteria_obfs_enable %}
  "obfs": {
    "type": "salamander",
    "password": "{{ ctx.hconfig.proxy_path }}"
  },
{% endif %}

"users": [
  {% for user in ctx.users %}
    {
      "name": "{{ user.uuid }}", 
      "password": "{{ user.uuid }}"
    },
  {% endfor %}
],
"masquerade": "http://{{ ctx.domain.name }}:80/",
{% include 'hiddify-core/server/tls/tls' %}
