"type": "naive",
"users": [
  {% for user in ctx.users %}
    {
      "username": "{{ user.uuid }}", 
      "password": "{{ ctx.proxy.path }}"
    },
  {% endfor %}
],
"network": "{{ 'udp' if ctx.proxy.tls_layer == 'quic_tls' else 'tcp' }}",
{# L7 gateway terminates TLS; SNI gateway / direct listen keep TLS on the inbound. #}
{% if ctx.proxy.mode != 'domains_l7_gateway' %}
{% include 'hiddify-core/server/tls/tls' %}
{% endif %}
