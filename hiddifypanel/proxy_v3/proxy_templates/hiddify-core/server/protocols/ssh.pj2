{% skip("ssh_server_enable = " ~ hconfig.ssh_server_enable) if not hconfig.ssh_server_enable %}
"type": "ssh",
{% include 'hiddify-core/server/snippets/listen' %},
{% include 'hiddify-core/server/snippets/inbound_meta' %},
"host_key": [
  "{{ hconfig.ssh_host_rsa_pk | replace('\n', '\\n') }}",
  "{{ hconfig.ssh_host_ecdsa_pk | replace('\n', '\\n') }}",
  "{{ hconfig.ssh_host_ed25519_pk | replace('\n', '\\n') }}"
],
"users": [
  {% for user in users %}
  {"user": "{{ user.uuid }}", "public_key": "{{ user.ed25519_public_key }}"},
  {% endfor %}
]
