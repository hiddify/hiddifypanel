"type": "ssh",
"host_key": [
  "{{ ctx.hconfig.ssh_host_rsa_pk | replace('\n', '\\n') }}",
  "{{ ctx.hconfig.ssh_host_ecdsa_pk | replace('\n', '\\n') }}",
  "{{ ctx.hconfig.ssh_host_ed25519_pk | replace('\n', '\\n') }}"
],
"users": [
  {% for user in ctx.users %}
  {
    "user": "{{ user.uuid }}", 
    "public_key": "{{ user.ed25519_public_key }}"},
  {% endfor %}
]
