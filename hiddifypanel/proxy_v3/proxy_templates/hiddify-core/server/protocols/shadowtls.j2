{{ skip("shadowtls_enable = " ~ ctx.hconfig.shadowtls_enable) if not ctx.hconfig.shadowtls_enable }}
"type": "shadowtls",
{% include 'hiddify-core/server/snippets/listen' %},
"version": 3,
"users": [
  {"password": "{{ ctx.hconfig.shared_secret }}"}
],
"handshake": {
  "server": "{{ ctx.domain.sni }}",
  "server_port": 443
},
"handshake_for_server_name": {
  "{{ ctx.domain.sni }}": {
    "server": "{{ ctx.domain.sni}}",
    "server_port": 443
  }
},
"strict_mode": false,
{% include 'hiddify-core/server/snippets/inbound_meta' %}
