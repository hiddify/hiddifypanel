{{ skip("xhttp_enable = " ~ ctx.hconfig.xhttp_enable) if not ctx.hconfig.xhttp_enable }}
"transport": {
  "type": "xhttp",
  "path": "/{{ proxy.path }}",
  "host": "{{ domain.host }}",
  "mode": "auto",
  "headers":{
    "User-Agent": "{{default_useragent_string}}"
  },
  {% if proxy.is_download_upload_different() or alpns != download_alpns %}
  "downloadSettings": {
    "path": "/{{ proxy.path }}",
    "host": "{{ domain.download.host }}",
    "server": "{{ domain.download.server() }}",
    "server_port": {{ domain.download.port or proxy.download_port }},

    "headers": {
      "User-Agent": "{{default_useragent_string}}"
    },
    {% with domain=domain.download, alpns=download_alpns, tls_layer=proxy.download_tls_layer %}
      {% include 'hiddify-core/client/tls/tls_http' %}
    {% endwith %}
  }
  {% endif %}
},
