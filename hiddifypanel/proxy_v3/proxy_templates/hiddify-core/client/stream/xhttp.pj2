{{ skip("xhttp_enable = " ~ ctx.hconfig.xhttp_enable) if not ctx.hconfig.xhttp_enable }}
"transport": {
  "type": "xhttp",
  "path": "/{{ proxy.path }}",
  "host": "{{ domain.host }}",
  "mode": "auto",
  "headers":{
    "User-Agent": "{{default_useragent_string}}"
  },
  {% if domain.download %}
  "downloadSettings": {
    "path": "/{{ proxy.path }}",
    "host": "{{ domain.download.host }}",
    "server": "{{ domain.download.server() }}",

    "headers": {
      "User-Agent": "{{default_useragent_string}}"
    },
    {% with domain=domain.download, alpns=download_alpns, tls=download_tls %}
      {% include 'hiddify-core/client/tls/tls_http' %}
    {% endwith %}
  }
  {% endif %}
},
