{% skip("xhttp_enable = " ~ hconfig.xhttp_enable) if not hconfig.xhttp_enable %}
"transport": {
  "type": "xhttp",
  "path": "/{{ proxy.path }}",
  "host": "{{ domain.host }}",
  "mode": "auto",
  "headers":{
    "User-Agent": "{{default_useragent_string}}"
  },
  {% if domain.download and proxy.download %}
  "downloadSettings": {
    "path": "/{{ proxy.path }}",
    "host": "{{ domain.download.server }}",
    "headers": {
      "User-Agent": "{{default_useragent_string}}"
    },
    {%if proxy.download.tls %}
    "tls": {
      "enabled": "true",
      "server_name": "{{ domain.download.sni }}",
      "insecure": {% if domain.download.allow_insecure %}true{% else %}false{% endif %},
      "alpn": {{proxy.download.alpn_list | tojson }}
      
    }
    {% endif %}
  }
  {% endif %}
},
