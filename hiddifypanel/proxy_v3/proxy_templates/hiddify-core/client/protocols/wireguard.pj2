{% skip("wireguard_enable = " ~ hconfig.wireguard_enable) if not hconfig.wireguard_enable %}
"type": "wireguard",
{% if ctx.platform.app == "hiddify" and ctx.platform.app_version >= "4.2.0" %}
  "private_key": "{{ ctx.user.wg_pk }}",
  "mtu": 1380,
  "address": ["{{ ctx.user.wg_ipv4 }}/32"],
  "peers": [{
    "public_key": "{{ ctx.hconfig.wireguard_public_key }}",
    "pre_shared_key": "{{ ctx.user.wg_psk }}",
    "address": "{{ ctx.domain.server }}",
    "port": {{ ctx.proxy.port }},
    "allowed_ips": ["0.0.0.0/0", "::/0"]
  }],
  "noise": {
    "fake_packet": {
      "enabled": true,
      "count": {{ ctx.hconfig.wireguard_noise_trick }}
    }
  },
{% else %}
  "server": "{{ ctx.domain.server }}",
  "server_port": {{ ctx.proxy.port }},
  "local_address": "{{ ctx.user.wg_ipv4 }}/32",
  "private_key": "{{ ctx.user.wg_pk }}",
  "peer_public_key": "{{ ctx.hconfig.wireguard_public_key }}",
  "pre_shared_key": "{{ ctx.user.wg_psk }}",
  "mtu": 1380,
    {% if ctx.platform.app == "hiddify" and ctx.platform.app_version > "0.15.0" %}
    "fake_packets": {{ ctx.hconfig.wireguard_noise_trick }},
    {% endif %}
  {% endif %}
