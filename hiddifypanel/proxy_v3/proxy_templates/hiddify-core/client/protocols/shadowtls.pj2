"type": "shadowtls",
"server": "{{ proxy.server }}",
"server_port": {{ proxy.port }},
"version": 3,
"password": "{{ ctx.hconfig.shared_secret }}",
"tls": {
  "enabled": true,
  "server_name": "{{ ctx.hconfig.shadowtls_fakedomain }}",
  "utls": {
    "enabled": true,
    "fingerprint": "none"
  }
},
