"type": "mieru",
"server": "{{ proxy.server }}",
"multiplexing": "{{ ctx.hconfig.mieru_multiplexing }}",
"handshake_mode": "{{ ctx.hconfig.mieru_handshake }}",
"username": "{{ ctx.user.uuid }}",
"password": "h",
"portBindings": [
  {% for protocol,ports in [("TCP",proxy.tcp_port_ranges),("UDP",proxy.udp_port_ranges)] %}
  {% for entry in ports%}
  {
    "protocol": "{{protocol}}",
    {% if entry is number %}
    "port": {{ entry }}
    {% else %}
    "portRange": "{{ entry }}"
    {% endif %}
  },
  {% endfor %}
  {% endfor %}
  
],
