
{{ skip("snell needs sing-box 1.14.0+") if ctx.platform.singbox.version < "1.14.0" }}
{# Snell v5 or v6 server (the preset sets snell_version). A v5 server speaks the v4 wire protocol, so its client uses 4. #}
{% set v = snell_version|default(5) %}
"type": "snell",
"server": "{{ proxy.server }}",
"server_port": {{ proxy.port }},
"version": {{ 6 if v == 6 else 4 }},
"psk": "{{ ctx.hconfig.shared_secret }}",
"userkey": "{{ ctx.user.uuid }}"
