"type": "hysteria2",
"server": "{{ proxy.server }}",
{% if proxy.udp_port_ranges %}
  "server_ports": {{ proxy.udp_port_ranges | tojson }},
{% else %}
  "server_port": {{ proxy.udp_port }},
{% endif %}
"password": "{{ ctx.user.uuid }}",
"up_mbps": {{ ctx.hconfig.hysteria_up_mbps }},
"down_mbps": {{ ctx.hconfig.hysteria_down_mbps }},
{% if ctx.hconfig.hysteria_obfs_enable %}
  "obfs": {
    "type": "salamander",
    "password": "{{ ctx.hconfig.proxy_path }}"
  },
{% endif %}
{% include 'hiddify-core/client/tls/tls_http' %}
