"type": "shadowtls",
"server": "{{ proxy.server }}",
"server_port": {{ proxy.port }},
"version": 3,
"password": "{{ ctx.hconfig.shared_secret }}",
"tls": {
  "enabled": true,
  "server_name": "{{ domain.sni }}",
  {% set fp = ctx.hconfig.utls or "" %}
  {% if fp and fp!="none" %}
  "utls": {
    "enabled": true,
    "fingerprint": "{{ fp }}"
  },
  {% endif %}
},
