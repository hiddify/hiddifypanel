{% set _alpn = proxy.alpn|default('') %}
{% skip('h2_enable is false') if _alpn in ['tls_h2', 'tls_h1_h2', 'tls_h1_h2_h3', 'h2'] and not hconfig.h2_enable %}
{% skip('quic_enable is false') if _alpn in ['tls_h3', 'tls_h1_h2_h3'] and not hconfig.quic_enable %}
{% skip('http_proxy_enable = ' ~ hconfig.http_proxy_enable) if not proxy.tls and not hconfig.http_proxy_enable %}
{% if proxy.tls %}
"tls": {
  "enabled": true,
  "engine": "{{ hconfig.singbox_tls_engine }}",
  "disable_sni": {{ not domain.sni |jsbool}},
  "server_name": "{{ domain.sni }}",
  "insecure": {{domain.insecure |jsbool }},
  "alpn": {{proxy.alpn_list | tojson }}
  "certificate": "",
  "certificate_public_key_sha256": [
    {% for pin in domain.cert.pinnedPeerCertSha256 %}
    "{{ pin }}",
    {% endfor %}
  ],
  {% if hconfig.tls_ech_enable %}
  "ech": {
    "enabled": true,
    "config": [],
    "config_path": "",
    "query_server_name": "{{ domain.sni }}"
  },
  {% endif %}
  "utls": {
    "enabled": {{ len(hconfig.fingerprint) |jsbool }},
    "fingerprint": "{{hconfig.fingerprint}}"
  }
},
{% endif %}
