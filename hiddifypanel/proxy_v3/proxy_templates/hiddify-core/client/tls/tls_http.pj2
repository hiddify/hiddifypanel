{% set domain = domain if domain is defined else ctx.proxy.domain %}
{% set tls_layer = tls_layer if tls_layer is defined else ctx.proxy.tls_layer %}
{% if tls_layer != 'http' %}
"tls": {
  "enabled": true,
  {%if not domain.sni%} "disable_sni": true {%endif%},
  "server_name": "{{ domain.sni }}",
  

  {% if alpns %}
    "alpn": {{ alpns | tojson }},
  {% endif %}

  {% set fp = ctx.hconfig.utls or "" %}
  {% if fp and fp!="none" %}
  "utls": {
    "enabled": true,
    "fingerprint": "{{ fp }}"
  },
  {% endif %}

  {% if domain.is_reality() %}
    "reality": {
      "enabled": true,
      "public_key": "{{ ctx.hconfig.reality_public_key }}",
      "short_id": "{{ ctx.hconfig.reality_short_ids | choose_random }}"
    }
  {% else %}
    {% if ctx.platform.singbox.version >= "1.14.0" %}
      "engine": "{{ ctx.hconfig.singbox_tls_engine }}",
    {% endif %}
    {%if domain.allow_insecure%} 
      "insecure": true,
      "certificate_public_key_sha256": [
        {% for pin in domain.cert.pinnedPeerCertSha256 %}
        "{{ pin }}",
        {% endfor %}
      ],
    {%endif%}

    {% if ctx.hconfig.tls_ech_enable %}
    "ech": {
      "enabled": true,
      "config": [],
      "config_path": "",
      "query_server_name": "{{ domain.sni }}"
    },
    {% endif %}
  {% endif %}
},
{% endif %}
