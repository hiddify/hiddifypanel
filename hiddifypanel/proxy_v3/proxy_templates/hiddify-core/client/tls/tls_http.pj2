
{% set domain=domain or ctx.domain}
{%set tls=tls or ctx.proxy.tls%}
{% if tls %}
"tls": {
  "enabled": true,
  {%if ctx.platform.version >= 5.0.0 %}
    "engine": "{{ ctx.hconfig.singbox_tls_engine }}",
  {%endif%}  
  "disable_sni": {{ not domain.sni |jsbool}},
  "server_name": "{{ domain.sni }}",
  "insecure": {{domain.insecure |jsbool }},
  {%if alpns %}
  "alpn": {{alpns | tojson}},
  {%endif%}
  
  "certificate_public_key_sha256": [
    {% for pin in domain.cert.pinnedPeerCertSha256 %}
    "{{ pin }}",
    {% endfor %}
  ],
  {% if ctx.hconfig.tls_ech_enable %}
  "ech": {
    "enabled": true,
    "config": [],
    "config_path": "",
    "query_server_name": "{{ domain.sni }}"
  },
  {% endif %}
  "utls": {
    "enabled": {{ len(ctx.hconfig.fingerprint) |jsbool }},
    "fingerprint": "{{ctx.hconfig.fingerprint}}"
  },
  {%if domain.is_reality() %}
  "reality": {
    "enabled": true,
    "public_key": "{{ ctx.hconfig.reality_public_key }}",
    "short_id": "{{ ctx.hconfig.reality_short_ids|choose_random }}"
  }
  {%endif%}
},
{% endif %}
