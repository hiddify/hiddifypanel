{#
  Builtin node_configs (hiddify-core / sing-box JSON).
  Pulls client configs from child nodes via get_nodes_configs().
  Enabled by default on parent panels (fetches child node configs).
#}
{% set node_configs = get_nodes_configs("hiddify-core", "1h") %}
{% block outbounds %}
     {% for conf in node_configs if conf %}
          {% for outbound in remote_proxy_outbounds(conf, "hiddify-core") %}
               {{ outbound | tojson }},
          {% endfor %}
     {% endfor %}
{% endblock %}

{% block endpoints %}
     {% for conf in node_configs if conf %}
          {% for endpoint in remote_endpoints(conf) %}
               {{ endpoint | tojson }},
          {% endfor %}
     {% endfor %}
{% endblock %}
