"transport": {
  "type": "http",
  {# Xray's raw TCP HTTP header is HTTP/1.1 also over TLS; the http transport would speak h2 there (hiddify-core 5.1+) #}
  {% if ctx.proxy.tls_layer != "http" %}
  "version": 1,
  {% endif %}
  "path": "/{{ proxy.path }}",
  "host": ["{{ proxy.domain.host }}"],
  "idle_timeout": "15s",
  "ping_timeout": "15s",
  {#- rawhttp: the browser-like headers that xray's server can read, sent in any order: see rawhttp_headers -#}
  {%- set headers %}{"Host": "{{ proxy.domain.host }}", {% include 'hiddify-core/client/default_headers' %}}{% endset %}
  "headers": {{ rawhttp_headers(headers, "/" ~ proxy.path, method="PUT", xray=False)|tojson }},
},
