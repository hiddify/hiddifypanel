    "tag":"{{tag}}",
    {% include 'hiddify-core/client/tag' %},
    {% include '__PROTO_SLUG__' %}
  },
  {
    "tag":"{{detour}}",
    {% include '__SHADOWTLS_SLUG__' %}
  },

{%endfor%}
{% endblock %}
