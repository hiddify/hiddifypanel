{% block endpoints %}
  {% if (ctx.platform.singbox.version >= "1.11.0") %}
    {% for ctx in ctx.iter_ctx_domains() %}
      {% set proxy = ctx.proxy %}
      {% set domain = ctx.proxy.domain %}
      {% set tag %}{%- include 'hiddify-core/client/tag' -%}{% endset %}
      {
        "tag": "{{ tag | trim_no_line }}",
        {% include 'hiddify-core/client/protocols/wireguard' %}
      },
    {% endfor %}
  {% endif %}
{% endblock %}
{% block outbounds %}
  {% if (ctx.platform.singbox.version < "1.11.0") %}
    {% for ctx in ctx.iter_ctx_domains() %}
      {% set proxy = ctx.proxy %}
      {% set domain = ctx.proxy.domain %}
      {% set tag %}{%- include 'hiddify-core/client/tag' -%}{% endset %}
      {
        "tag": "{{ tag | trim_no_line }}",
        {% include 'hiddify-core/client/protocols/wireguard' %}
      },
    {% endfor %}
  {% endif %}
{% endblock %}
