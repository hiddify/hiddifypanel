{# finalmask is an object (sing-box FinalMaskOptions / Xray finalmask), never a quoted string. #}
{% set finalmask = ctx.proxy.domain.extra.finalmask  if ctx.proxy.domain.extra.finalmask else "" %}
{% if finalmask and ctx.platform.hiddify.version >= "5.0.0" %}
  "finalmask": {{ finalmask }},
{% endif %}
