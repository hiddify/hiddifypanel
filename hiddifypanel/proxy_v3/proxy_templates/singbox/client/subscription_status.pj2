{% if hconfig.show_usage_in_sublink and not platform.is_hiddify %}
{% set tag = '⏳ ' if user.is_active else '✖ ' %}
{% if user.usage_limit_GB < 1000 %}
{% set tag = tag ~ (user.current_usage_GB|round(3)) ~ '/' ~ (user.usage_limit_GB|string|replace('.0', '')) ~ 'GB' %}
{% elif user.usage_limit_GB < 100000 %}
{% set tag = tag ~ (user.current_usage_GB / 1000|round(3)) ~ '/' ~ ((user.usage_limit_GB / 1000)|round(1)|string|replace('.0', '')) ~ 'TB' %}
{% else %}
{% set tag = tag ~ '#No Usage Limit' %}
{% endif %}
{% set tag = tag ~ ' 📅 ' %}
{% if user.expire_days < 1000 %}
{% set tag = tag ~ _('%(expire_days)s days', expire_days=user.expire_days) %}
{% else %}
{% set tag = tag ~ '#No Time Limit' %}
{% endif %}
{% set tag = tag|trim %}
{
  "tag": {{ tag|tojson }},
  "type": "block"
},
{% endif %}
{% if not user.is_active %}
{
  "tag": {{ _('✖ Package Ended')|tojson }},
  "type": "block"
},
{% endif %}
