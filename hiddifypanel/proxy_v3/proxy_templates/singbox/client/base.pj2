{% block base_config %}
{
  "outbounds": [
    {% include 'singbox/client/subscription_status' %}
    {% if ctx.user.is_active %}
    {% include 'hiddify-core/client/proxies_group' %}
    {% block outbounds %}{% endblock %}
    {% endif %}
    {"tag": "direct", "type": "direct"},
    {"tag": "block", "type": "block"},
    {"tag": "dns-out", "type": "dns"}
  ],
  "endpoints": [
    {% if ctx.user.is_active %}
    {% block endpoints %}{% endblock %}
    {% endif %}
  ],
  "route": {
    "auto_detect_interface": true,
    "override_android_vpn": {%if ctx.platform.os == "android" %}true{%else%}false{%endif%},
    "final": "Select",
    "rules": []
  }
}
{% endblock %}