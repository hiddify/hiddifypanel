{%- if ctx.hconfig.show_usage_in_sublink and not ctx.platform.is_hiddify %}
{%- set name = ctx.user.name ~ " " ~  ('⏳ ' if ctx.user.is_active else '✖ ') %}
{%- if ctx.user.usage_limit_GB < 1000 %}
{%- set name = name ~ (ctx.user.current_usage_GB|round(3)) ~ '/' ~ (ctx.user.usage_limit_GB|string|replace('.0', '')) ~ 'GB' %}
{%- elif ctx.user.usage_limit_GB < 100000 %}
{%- set name = name ~ ((ctx.user.current_usage_GB / 1000)|round(3)) ~ '/' ~ (((ctx.user.usage_limit_GB / 1000)|round(1))|string|replace('.0', '')) ~ 'TB' %}
{%- else %}
#No Usage Limit
{%- endif %}
{%- if ctx.user.expire_days < 1000 %}
{%- set name = name ~ ' 📅 ' ~_('%(expire_days)s days', expire_days=ctx.user.expire_days) %}
{%- else %}
#No Time Limit
{%- endif %}
{%- set name = name|trim %}
{%- if name|length > 3 %}
#{{name}}
trojan://1@{{ fake_ip_for_sub_link }}?sni=fake_ip_for_sub_link&security=tls#{{ name|urlencoded }}
{%- endif %}
{%- endif %}
{%- if not ctx.user.is_active %}
#{{ _('✖ Package Ended') }}
trojan://1@1.1.1.1#{{ _('✖ Package Ended')|urlencoded }}
{%- endif %}
