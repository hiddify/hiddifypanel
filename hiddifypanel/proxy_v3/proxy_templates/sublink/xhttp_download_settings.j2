{# Only included when proxy.is_download_upload_different() #}
{% set dl = proxy.domain.download %}
{
  "address": "{{ dl.server() }}",
  "port": {{ dl.port or proxy.download_port }},
  "network": "xhttp",
  {% with domain=dl, tls_layer=proxy.effective_download_tls_layer %}
    {% include 'xray/client/security/tls' %}
  {% endwith %}
  "xhttpSettings": {
    "path": "/{{ proxy.path }}",
    "host": "{{ dl.host }}",
    "mode": "auto",
    "headers": {
        {%if ctx.hconfig.default_useragent_string %}"User-Agent": "{{ctx.hconfig.default_useragent_string}}" {%endif%}
    }
  }
}
