{
  "address": "{{ proxy.domain.download.server() if proxy.domain.download else proxy.domain.server() }}",
  "port": {{ proxy.tcp_port }},
  "network": "xhttp",
  "xhttpSettings": {
    "path": "{{ proxy.path }}",
    "host": "{{ proxy.domain.host }}",
    "mode": "auto",
    "extra": {
      "headers": {}
    }
  },
  "security": "tls",
  "tlsSettings": {
    "serverName": "{{ (proxy.domain.download.sni if proxy.domain.download else proxy.domain.sni) }}",
    "allowInsecure": {{ 'true' if (proxy.domain.download.allow_insecure if proxy.domain.download else proxy.domain.allow_insecure) else 'false' }},
    "fingerprint": "{{ proxy.fingerprint|default('') }}",
    "alpn": ["{{ proxy.download_alpn|default('h2') }}"]
  }
}
