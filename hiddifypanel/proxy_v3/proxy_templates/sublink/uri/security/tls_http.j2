{% set domain = domain if domain is defined else ctx.proxy.domain %}
{% set tls_layer = (tls_layer if tls_layer else ctx.proxy.tls_layer) or 'http' %}

{% if tls_layer != 'http' %}

    {# uTLS fingerprint is TCP-only; omit fp on QUIC (h3) links. #}
    {% if tls_layer not in ["quic_tls", "quic_tcp_tls"] %}
    {# Xray's other uTLS hellos offer h2 whatever "alpn" says: a CDN would answer an HTTP/1.1-only xhttp leg in HTTP/2 #}
    {% if ctx.proxy.transport == "xhttp" and tls_layer == "tls_h1" and domain.mode == "cdn" %}
        {% set qp.fp = 'android' %}
    {% elif ctx.hconfig.utls and ctx.hconfig.utls != 'none' %}
        {% set qp.fp = ctx.hconfig.utls %}
    {% elif domain.is_reality() %}
        {% set qp.fp = 'chrome' %}
    {% endif %}
    {% endif %}
    {% set qp.sni = domain.sni %}
    {% if domain.is_reality() %}
        {% set qp.security = 'reality' %}
        {% set qp.pbk = ctx.hconfig.reality_public_key %}
        {% set qp.sid = ctx.hconfig.reality_short_ids | choose_random %}
    {%else%}
        {% set qp.security = 'tls' %}
        {% set qp.alpn = ",".join(tls_layer.alpns()) %}
        {% if domain.allow_insecure %}
            {% set qp.allowInsecure = 'true' %}
            {% set qp.insecure = 'true' %}
            {% set qp.pcs = ",".join(domain.cert.pinnedPeerCertSha256)%}
        {% endif %}

        {% if domain.extra.ech_config %}
            {% set qp.ech = domain.extra.ech_config %}
        {% elif domain.ech and domain.echinfo %}
            {% set qp.ech = domain.echinfo %}
        {% endif %}
        {# TLS fragment is FinalMask (``fm`` query from domain.finalmask), not a separate fragment= param. #}
    {% endif %}

{% else %}
    {% set qp.security = 'none' %}
{% endif %}
