{{ skip('h2_enable is false') if proxy.alpn in ['tls_h2', 'tls_h1_h2', 'tls_h1_h2_h3', 'h2'] and not ctx.hconfig.h2_enable }}

{% if proxy.tls %}
    {{ skip('quic_enable is false') if proxy.alpn in ['tls_h3', 'tls_h1_h2_h3'] and not ctx.hconfig.quic_enable }}

    {% set qp.security = 'tls' %}

    {% if proxy.fingerprint and proxy.fingerprint != 'none' %}
        {% set qp.fp = proxy.fingerprint %}
    {% endif %}
    
    {% if ctx.domain.mode == 'Fake' or proxy.allow_insecure %}
        {% set qp.allowInsecure = 'true' %}
        {% set qp.insecure = 'true' %}
    {% endif %}

    {% if ctx.domain.ech %}
        {% set qp.ech = ctx.domain.ech %}
    {% endif %}

    {% set qp.alpn = proxy.alpn %}
    {% set qp.sni = ctx.domain.sni %}
{% else %}
    {{ skip('http_proxy_enable = ' ~ ctx.hconfig.http_proxy_enable) if  not ctx.hconfig.http_proxy_enable }}
    {% set qp.security = 'none' %}
{% endif %}
