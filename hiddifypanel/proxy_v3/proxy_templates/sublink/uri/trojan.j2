{% for ctx in ctx.iter_ctx_domains() %}
  {# Trojan is meant to run inside TLS: never offered over plain HTTP #}
  {{ skip("Trojan over plain HTTP") if ctx.proxy.tls_layer == "http" }}
  {% set proxy = ctx.proxy %}
  {% set uri = namespace(
    protocol = 'trojan',
    password = ctx.user.uuid,
    host=proxy.server,
    port=proxy.port,
    query_params=namespace(hiddify='1'),
  ) %}
  {% set uri.fragment %}{%- include 'sublink/tag' -%}{% endset %}

  {% set qp = uri.query_params %}
  {% if ctx.proxy.domain.finalmask %}{% set qp.fm = ctx.proxy.domain.finalmask %}{% endif %}

  {% include '__TLS_SLUG__' %}
  {% include '__TRANSPORT_SLUG__' %}

  {% include 'sublink/uri/final_link_maker' %} {#making trojan://uri.....#}
{% endfor %}
