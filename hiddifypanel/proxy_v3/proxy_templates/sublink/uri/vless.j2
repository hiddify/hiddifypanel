{# https://github.com/XTLS/Xray-core/discussions/4877  #}
{# https://github.com/XTLS/Xray-core/discussions/716  #}
{#https://xray-checker.kutovoy.dev/configuration/subscription/#}
{% for ctx in ctx.iter_ctx_domains() %}
  {% set proxy = ctx.proxy %}
  {% set uri = namespace(
    protocol = 'vless',
    user=ctx.user.uuid,
    host=proxy.server,
    port=proxy.port,
    query_params=namespace(hiddify='1'),
  ) %}
  {% set uri.fragment %}{%- include 'sublink/tag' -%}{% endset %}
  {% set qp = uri.query_params %}
    {% if ctx.proxy.domain.finalmask %}{% set qp.fm = ctx.proxy.domain.finalmask | compactjson %}{% endif %}
    {% include '__TLS_SLUG__' %}
    {% include '__TRANSPORT_SLUG__' %}

  {# Vision (xtls-rprx-vision) is TCP+REALITY only — the Reality terminator inbound. #}
  {# Do not put flow on WS/gRPC/XHTTP/… links (#5640); those terminate as plain VLESS behind HAProxy. #}
  {% set reality_terminated = ctx.proxy.transport == "tcp" and ctx.proxy.domain.is_reality() %}
  {% if ctx.proxy.server_core == "xray" and ctx.hconfig.vless_flow and reality_terminated %}
    {% set qp.flow = ctx.hconfig.vless_flow %}
  {% endif %}
  {# Xray needs an explicit encryption; only an xray server can terminate a real one. #}
  {# raw VLESS on a REALITY domain ends at the reality termination, which can not use encryption #}
  {% set enc = ctx.hconfig.vless_encryption if ctx.proxy.server_core == "xray" and ctx.hconfig.vless_encryption and not reality_terminated else "none" %}
  {{ skip("VLESS encryption needs Hiddify 5+") if enc != "none" and ctx.platform.is_hiddify and ctx.platform.hiddify.version < "5.0.0" }}

  {{ skip("VLESS encryption needs Hiddify 5+ or an Xray client") if enc != "none" and ctx.platform.app_group != "xray" }}
  {% set qp.encryption = enc %}
  {% include 'sublink/uri/final_link_maker' %}
{% endfor %}
