{# TUIC v5: https://sing-box.sagernet.org/configuration/outbound/tuic/ #}
{% set cert = ctx.shared_cert %}
{% set sni = cert.server_name %}
{% set insecure = not cert.is_trusted %}
{% for ctx in ctx.iter_ctx_domains() %}
  {% set proxy = ctx.proxy %}
  {% set domain = proxy.domain %}
    
  {% set uri = namespace(
    protocol='tuic',
    user=ctx.user.uuid,
    password=ctx.user.uuid,
    host=proxy.server,
    port=proxy.udp_port or proxy.port,
    query_params=namespace(
      alpn='h3',
      congestion_control='cubic',
      udp_relay_mode='native',
    ),
  ) %}
  {% set qp = uri.query_params %}
  {% if sni %}
    {% set qp.sni = sni %}
  {% endif %}
  {% if insecure %}
    {% set qp.allow_insecure = '1' %}
  {% endif %}
  {% set uri.fragment %}{%- include 'sublink/tag' -%}{% endset %}
  {% include 'sublink/uri/final_link_maker' %}
{% endfor %}
