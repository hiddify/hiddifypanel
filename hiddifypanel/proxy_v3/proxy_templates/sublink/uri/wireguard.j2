{# The common wireguard:// format (v2rayN, NekoBox, Karing, Streisand, Hiddify): the private key as the user.
   `privatekey` repeats it for Hiddify before 2026-02, which reads it only from the query; `ifp` is Hiddify's noise. #}
{% for ctx in ctx.iter_ctx_domains() %}
  {% set proxy = ctx.proxy %}
  {% set uri = namespace(
    protocol='wireguard',
    user=ctx.user.wg_pk|urlencoded,
    host=proxy.server,
    port=proxy.udp_port or proxy.port,
    query_params={
      'publickey': ctx.hconfig.wireguard_public_key,
      'presharedkey': ctx.user.wg_psk,
      'address': (ctx.user.wg_ipv4 ~ '/32') if ctx.user.wg_ipv4 else '',
      'mtu': '1380',
      'reserved': '0,0,0',
      'privatekey': ctx.user.wg_pk,
      'ifp': ctx.hconfig.wireguard_noise_trick,
    },
  ) %}
  {% set uri.fragment %}{%- include 'sublink/tag' -%}{% endset %}
  {% include 'sublink/uri/final_link_maker' %}
{% endfor %}
