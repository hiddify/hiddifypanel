upstreams = []
show_link = []

[general]
{% if ctx.hconfig.telegram_adtag %}
ad_tag = "{{ ctx.hconfig.telegram_adtag }}"
{% endif %}
prefer_ipv6 = false
fast_mode = true
use_middle_proxy = false
middle_proxy_nat_probe = false
middle_proxy_nat_stun_servers = []
middle_proxy_pool_size = 2
middle_proxy_warm_standby = 0
me_keepalive_enabled = true
me_keepalive_interval_secs = 25
me_keepalive_jitter_secs = 5
me_keepalive_payload_random = true
me_warmup_stagger_enabled = true
me_warmup_step_delay_ms = 500
me_warmup_step_jitter_ms = 300
me_reconnect_max_concurrent_per_dc = 1
me_reconnect_backoff_base_ms = 500
me_reconnect_backoff_cap_ms = 30000
me_reconnect_fast_retry_count = 1
stun_iface_mismatch_ignore = false
unknown_dc_log_path = "unknown-dc.txt"
log_level = "normal"
disable_colors = false

[general.modes]
classic = true
secure = true
tls = true

[general.links]
show = []

[network]
ipv4 = true
prefer = 4
multipath = false

[server.api]
enabled = true
listen = "127.0.0.1:10088"
whitelist = ["127.0.0.1/32", "::1/128"]

[[server.listeners]]
ip = "127.0.0.1"
port = 1001
transport = "mtproxy"
proxy_protocol = true


{%- set webdomains = [] %}{% for d in ctx.domains if d.support_telegram_webproxy() %}{% set _ = webdomains.append(d) %}{% endfor %}
{%- if ctx.hconfig.telegram_webproxy_enable and webdomains %}

[[server.listeners]]
ip = "127.0.0.1"
port = 18080
transport = "web"
proxy_protocol = false
web_client_ip_source = "x_forwarded_for"
web_trusted_proxy_cidrs = ["127.0.0.1/32"]


{#- telemt's wildcard hosts (allow_wildcard_hosts, telemt >= 3.5.16): the domains on the main public IP share one "*"
    group, so the users' profiles are kept once instead of once per domain. A domain on another IP keeps an exact group
    (public_addr is fixed per group; an exact host is matched before "*"). Unknown hosts get the decoy in the outer
    layer (HAProxy's domain routing), before telemt. #}
{%- set w = namespace(addrs=[], main='') %}
{%- for d in webdomains %}{% set _ = w.addrs.append((d.ips.ips or ['127.0.0.1'])[0] ~ ':443') %}{% endfor %}
{%- for a in w.addrs %}{% if not w.main or w.addrs.count(a) > w.addrs.count(w.main) %}{% set w.main = a %}{% endif %}{% endfor %}
{%- set others = [] %}{% for d in webdomains %}{% if w.addrs[loop.index0] != w.main and d.name not in others | map(attribute='name') | list %}{% set _ = others.append(d) %}{% endif %}{% endfor %}
{%- set n_users = ctx.users | selectattr('uuid_hex') | list | length %}

[web]
enabled = true 
carriers = ["websocket-lanes", "websocket", "https-lanes", "https"]
decoy_fasttrack_mode = "off"
allow_wildcard_hosts = true

[web.limits]
max_profiles = {{ [n_users * ((others | length) + 2), 1] | max }}
max_vhosts = {{ [others | length, 1] | max }}
memory_envelope_bytes = 1610612736

[web.limits.wildcard]
max_rules = 32
max_profiles_per_request = {{ [n_users, 256] | max }}
cache_hosts = 256
cache_bytes = 8388608
cold_hmac_per_minute = {{ [n_users * 1000, 1000000] | max }}
cold_hmac_burst = {{ [n_users, 65536] | max }}

{%- set decoy = '{ mode = "http_upstream", upstream = "http://127.0.0.1:18081" }' %}
{%- set profiles %}[
{%- for u in ctx.users if u.uuid_hex %}
  { user = "{{ u.uuid_hex }}", secret_mode = "dd" },
{%- endfor %}
]{%- endset %}

[[web.vhosts]]
hosts = ["*"]
base_path = "{{ ctx.hconfig.telegram_base_path }}"
public_addr = "{{ w.main }}"
decoy = {{ decoy }}
profiles = {{ profiles }}

{#- telemt refuses a duplicate vhost host: each domain name once #}
{%- for d in others %}

[[web.vhosts]]
host = "{{ d.name }}"
base_path = "{{ ctx.hconfig.telegram_base_path }}"
public_addr = "{{ (d.ips.ips or ['127.0.0.1'])[0] }}:443"
decoy = {{ decoy }}
profiles = {{ profiles }}
{%- endfor %}


{% endif %}

{#- The FakeTLS names: the domains assigned to the Telegram FakeTLS proxy (an SNI proxy, like ShadowTLS) #}
{%- set tg = namespace(names=[]) %}
{%- for p in ctx.proxies if p.mode == "domains_sni_gateway" and "telegram_faketls" in p.categories %}
{%- for pd in p.iter_proxies_with_domain() %}{% if pd.domain.sni not in tg.names %}{% set _ = tg.names.append(pd.domain.sni) %}{% endif %}{% endfor %}
{%- endfor %}
[censorship]
{#- telemt refuses an empty name (and still runs the web proxy and its API): with no domain assigned, the decoy site #}
tls_domain = {{ (tg.names[0] if tg.names else (ctx.hconfig.decoy_domain or 'www.wikipedia.org')) | tojson }}
tls_domains = {{ tg.names[1:] | tojson }}
mask = true
mask_port = 443
fake_cert_len = 2048
tls_emulation = false
tls_front_dir = "tlsfront"

[access]
replay_check_len = 65536
replay_window_secs = 1800
ignore_time_skew = false

[access.users]
default = "{{ (ctx.hconfig.shared_secret or '') | replace('-', '') }}"
{% for user in ctx.users  %}
{{ user.uuid_hex }} = "{{ user.uuid_hex }}"
{% endfor %}

[access.user_max_tcp_conns]

[access.user_expirations]

[access.user_data_quota]

[access.user_max_unique_ips]

[dc_overrides]
