#!/bin/bash
# Rendered by the panel (firewall/server/base) to generated/firewall.sh; services/firewall/run.sh runs it.
source /opt/hiddify-manager/scripts/common/utils.sh
source /opt/hiddify-manager/services/firewall/utils.sh

# open essential ports
allow_port "tcp" 22
allow_port "tcp" 80
allow_port "tcp" 443
allow_port "udp" 443
allow_port "udp" 53
allow_port "tcp" 53
# allow_port "udp" 3478

add2iptables46 "INPUT -p udp -m conntrack --ctstatus SEEN_REPLY,ASSURED,CONFIRMED -j ACCEPT"


add2iptables46 "OUTPUT -p udp -j ACCEPT"
add2iptables46 "OUTPUT -p tcp -j ACCEPT"
add2iptables46 "INPUT -i lo -j ACCEPT"

{#- The firewall opens exactly the panel's public ports (the same list the Public ports page shows): the gateway's TLS / HTTP
    ports, WireGuard and the custom proxies' own ports (hysteria, tuic, naive, mieru, shadowsocks, ssh, ...), each for the
    protocols it uses. #}
{%- for port, name in public_ports['tcp'].items() %}
allow_port "tcp" {{ port }} #{{ name }}
{%- endfor %}
{%- for port, name in public_ports['udp'].items() %}
allow_port "udp" {{ port }} #{{ name }}
{%- endfor %}

# ICMP for ipv4
add2iptables "INPUT -p icmp -j ACCEPT"
# add2iptables "INPUT -p icmp -m icmp --icmp-type 0 -m conntrack --ctstate NEW -j ACCEPT"
# add2iptables "INPUT -p icmp -m icmp --icmp-type 3 -m conntrack --ctstate NEW -j ACCEPT"
# add2iptables "INPUT -p icmp -m icmp --icmp-type 11 -m conntrack --ctstate NEW -j ACCEPT"
# add2iptables "INPUT -p icmp -m icmp --icmp-type 12 -m conntrack --ctstate NEW -j ACCEPT"

# ICMP for ipv6
add2ip6tables "INPUT -p ipv6-icmp -j ACCEPT"
# add2ip6tables "INPUT -p ipv6-icmp --icmpv6-type 128 -m conntrack --ctstate NEW -j ACCEPT"
# add2ip6tables "INPUT -p ipv6-icmp --icmpv6-type 129 -m conntrack --ctstate NEW -j ACCEPT"
# add2ip6tables "INPUT -p ipv6-icmp --icmpv6-type 1 -m conntrack --ctstate NEW -j ACCEPT"
# add2ip6tables "INPUT -p ipv6-icmp --icmpv6-type 4 -m conntrack --ctstate NEW -j ACCEPT"
# add2ip6tables "INPUT -p ipv6-icmp --icmpv6-type 2 -m conntrack --ctstate NEW -j ACCEPT"

allow_apps_ports "sshd"
allow_apps_ports "x-ui"

add2iptables46 "INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT"
add2iptables46 "INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"

# The SSH server is a hiddify-core custom proxy now: its port is one of public_ports above (the old ssh_server_port setting is deprecated).

{# Domains' own TLS / HTTP ports are redirected to 443 / 80 (they need no ACCEPT rule: it is checked after the redirect). #}
{% set domain_tls_ports = ctx.domains|map(attribute='tls_port')|select|map('string')|unique|reject('in',['443'])|list %}
{% set domain_http_ports = ctx.domains|map(attribute='http_port')|select|map('string')|unique|reject('in',['80'])|list %}
redirect_domain_ports "{{domain_tls_ports|join(' ')}}" "{{domain_http_ports|join(' ')}}"

{% if ctx.hconfig.firewall %}
iptables -P INPUT DROP
iptables -P FORWARD DROP
has_ipv6 && ip6tables -P INPUT DROP
has_ipv6 && ip6tables -P FORWARD DROP
{%else%}
iptables -P INPUT ACCEPT
iptables -P FORWARD ACCEPT
has_ipv6 && ip6tables -P FORWARD ACCEPT
has_ipv6 && ip6tables -P INPUT ACCEPT
{%endif%}





save_firewall
