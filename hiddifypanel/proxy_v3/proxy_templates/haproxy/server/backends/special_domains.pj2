# =====================
# Special Domain Backends (REALITY / per-domain ports)
# Per-domain configurations, not from custom_proxies
# =====================

{% for d in domains if d['internal_port_special'] %}
{% set port = d['internal_port_special'] %}

backend sp_{{ d['mode'] }}_{{ port }}
    {% if hconfigs['core_type'] == 'xray' %}
    server xray abns@realityin_{{ port }} send-proxy-v2
    {% else %}
    server hiddify 127.0.0.1:{{ port }} send-proxy-v2
    {% endif %}

backend sp_{{ d['mode'] }}_http_{{ port }}
    mode http
    server sp_decoy {{ d['domain'] }}:80
{% endfor %}
