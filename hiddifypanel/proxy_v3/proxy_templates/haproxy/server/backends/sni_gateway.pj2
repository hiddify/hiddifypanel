# =====================
# Special Domain SNI Proxy (REALITY / per-domain ports)
# =====================

{% for p in ctx.proxies if p.mode == "domains_sni_gateway" %}
  {% for pd in p.iter_proxies_with_domain() %}
backend sp_{{ p.id }}_{{ pd.domain.name|slugify }}
  mode tcp
  server s 127.0.0.1:{{ pd.tcp_port }} send-proxy-v2
  
backend decoy_sp_{{ p.id }}_{{ pd.domain.name|slugify }}
  mode http
  server s {{ pd.domain.name }}:80
  {% endfor %}
{% endfor %}