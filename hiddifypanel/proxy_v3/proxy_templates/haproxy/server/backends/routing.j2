# =====================
# Core routing backends (panel, stats, xray force)
# =====================

backend panel
  mode http
  option forwardfor header X-Forwarded-For
  http-request set-header X-Real-IP %[src]
  http-request set-header X-Forwarded-Proto https
  http-response set-header X-Robots-Tag "noindex, nofollow"
  # HTTP/2 to the panel (the live channel's stream and its POSTs share one connection). WebSockets go as HTTP/1.1 upgrades,
  # whatever the browser used (over its HTTP/2 connection a WebSocket is an Extended CONNECT): granian has no WebSocket over
  # HTTP/2. This covers the live channel, the nodes' channel and Vite's hot reload in development.
  use-server s_ws if { req.hdr(upgrade) -i websocket } or METH_CONNECT
  # A node's usage report may wait up to 120 s for the parent's usage update (panel/usage.py USAGE_LOCK_WAIT)
  timeout server 150s
  server s 127.0.0.1:9000 proto h2
  server s_ws 127.0.0.1:9000 weight 0

backend default_decoy
  {% with decoy_host = ctx.hconfig.decoy_domain %}
    {% include 'haproxy/server/snippets/decoy_upstream' %}
  {% endwith %}



{% if ctx.hconfig.telegram_webproxy_enable  %}
# Telegram web proxy: telemt reads the client IP from X-Forwarded-For (trusts 127.0.0.1 only)
backend telemt_web
  mode http
  http-request set-header X-Forwarded-For %[src]
  timeout tunnel 1h
  server s 127.0.0.1:18080

# What telemt answers on its vhosts when a request is not a proxy one
frontend telemt_decoy
  bind 127.0.0.1:18081
  mode http
  default_backend default_decoy
{% endif %}

backend to_https_in_http_mode
    server s abns@https_in_http_mode send-proxy-v2

backend to_http_in_h2_http
    mode http
    server s abns@http_in_h2 send-proxy-v2 tfo proto h2

backend to_httpmode
    server s abns@http_in_h2 send-proxy-v2

backend to_https_in_ssl
    server s abns@https_in_ssl send-proxy-v2 tfo

# The built-in speed test page is gone: send users to Cloudflare's.
backend speedtest_redirect
    mode http
    http-request redirect location https://speed.cloudflare.com/ code 302

backend generate_204
    mode http
    http-request return status 204

backend hiddifypanel
    mode http
    http-request set-header X-Forwarded-For %[src]
    server hpanel 127.0.0.1:9000

backend proxy_stats_ui_backend
    mode http
    http-request set-path %[path,regsub(^/{{ ctx.hconfig.proxy_path_admin }}/proxy-stats/,/ui/)]
    server proxy_stats_ui 127.0.0.1:16756

backend proxy_stats_api_backend
    mode http
    http-request set-path %[path,regsub(^/{{ ctx.hconfig.proxy_path_admin }}/proxy-stats/api/,/)]
    server proxy_stats_api 127.0.0.1:16756

