# =====================
# L7 Gateway Proxy Backends
# mode=domains_l7_gateway, proto from proxy.l7_proto
# Alt-Svc per-backend so regular web traffic (nginx) is unaffected
# =====================

{% for proxy in custom_proxies if proxy.enable and proxy.server_tag %}
{% if proxy.mode == 'domains_l7_gateway' %}
{% set tag = proxy.server_tag %}
{% set port = proxy.port %}
{% set proto = proxy.l7_proto or 'h2' %}
{% set is_xray = proxy.server_core == 'xray' %}
backend {{ tag }}
    server s 127.0.0.1:{{ port }} send-proxy-v2 tfo


backend {{ tag }}-http
    mode http
    http-after-response set-header Alt-Svc 'h3=":443"; ma=2592000,h3-29=":443"; ma=2592000'
    server s 127.0.0.1:{{ port }} send-proxy-v2 tfo proto {{ proto }}

{% endif %}
{% endfor %}
