
mode http
http-request set-header Host {{ decoy_host }}
default-server resolvers dns resolve-prefer ipv4 resolve-opts allow-dup-ip init-addr last,libc,none check inter 1m fall 2 rise 1 observe layer4 error-limit 3 on-error mark-down
server s {{ decoy_host }}:443 ssl verify required ca-file @system-ca sni str({{ decoy_host }}) check-sni {{ decoy_host }}
server s_http {{ decoy_host }}:80 backup
