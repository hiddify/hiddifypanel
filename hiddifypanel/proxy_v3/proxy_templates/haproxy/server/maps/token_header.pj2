# x-api-key routing map (QUIC/H3 and TCP frontends)
# Add lines: <api-key-value> <backend-name>

# L7 gateway proxy paths
{%- for proxy in ctx.proxies if proxy.mode == 'domains_l7_gateway'  %}
{{ proxy.path |ljust(30)}} http_{{proxy.id}}_{{ proxy.path | slugify |ljust(40)}} #{{proxy.slug}}
{%- endfor %}
