############## L7 gateway proxy paths ##############
{%- for proxy in ctx.proxies if proxy.mode == 'domains_l7_gateway' %}
#{{proxy.slug}}
/{{ proxy.path |ljust(30)}} http_{{proxy.id}}_{{ proxy.path | slugify |ljust(40)}}
{%- endfor %}
############## end of L7 gateway ##############

# Panel and static paths
/{{ ctx.hconfig.proxy_path_client}}/generate_204 generate_204
/{{ ctx.hconfig.proxy_path}}/generate_204 generate_204

/{{ ctx.hconfig.proxy_path_admin }}/proxy-stats/api/ proxy_stats_api_backend
/{{ ctx.hconfig.proxy_path_admin }}/proxy-stats/ proxy_stats_ui_backend

/{{ ctx.hconfig.proxy_path_client}}/static/ panel
/{{ ctx.hconfig.proxy_path_client}}/ panel
/{{ ctx.hconfig.proxy_path_admin }}/ panel
/{{ ctx.hconfig.proxy_path}}/ panel

/{{ ctx.hconfig.health_secret_path }}/ panel

/.well-known/ nginx_dispatcher_http_h2
