# =====================
# QUIC/H3 Frontend
# =====================
frontend in-httpmode-quic
#  bind quic4@:902 ssl crt /opt/hiddify-manager/data/cert/ alpn h3

  mode http

  http-request set-var(txn.backend) path,map_beg({{ include_path(ctx, 'haproxy/server/maps/path_v10') }},default_decoy)
  http-request set-var(txn.backend) req.hdr(x-api-key),map_str({{ include_path(ctx, 'haproxy/server/maps/token_header') }},default_decoy) if  { var(txn.backend) -m str default_decoy } { req.hdr(x-api-key) -m found }
  http-request set-var(txn.backend) req.hdr(host),map_dom({{ include_path(ctx, 'haproxy/server/maps/http_domain') }},default_decoy) if { var(txn.backend) -m str default_decoy }

  #http-request set-var(txn.backend) req.hdr(host),map_dom({{ include_path(ctx, 'haproxy/server/maps/http_domain') }},default)
  #http-request set-var(txn.backend) req.hdr(x-api-key),map_str({{ include_path(ctx, 'haproxy/server/maps/token_header') }},default) if { var(txn.backend) -m str default }
  #http-request set-var(txn.backend) path,map_beg({{ include_path(ctx, 'haproxy/server/maps/path_v10') }},default_decoy) if { var(txn.backend) -m str default }

  use_backend %[var(txn.backend)] 
  default_backend default_decoy
