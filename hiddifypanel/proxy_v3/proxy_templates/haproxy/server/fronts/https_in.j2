# =====================
# SNI Proxy Frontend
# =====================
frontend https-in
    {#- 443 only: a domain's own TLS port is redirected to it by the firewall (the old tls_ports setting is not read) #}
    bind :443{% if ctx.hconfig.ipv6_enabled %},:::443 v4v6{% endif %} tfo
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }

    acl is_cdn src -f {{ include_path(ctx, 'haproxy/server/iplists/cloudflare') }} -f {{ include_path(ctx, 'haproxy/server/iplists/arvan') }} -f {{ include_path(ctx, 'haproxy/server/iplists/cloudfront') }}
    use_backend to_https_in_ssl if is_cdn

    use_backend %[req.ssl_sni,map_str({{ include_path(ctx, 'haproxy/server/maps/sni') }},to_https_in_ssl)] 

    default_backend to_https_in_ssl
