# =====================
# TCP Frontend
# =====================
frontend in-tcpmode
    {#- 80 only: a domain's own HTTP port is redirected to it by the firewall (the old http_ports setting is not read) #}
    bind :80{% if ctx.hconfig.ipv6_enabled %},:::80 v4v6{% endif %} tfo
    bind abns@https_in_ssl tfo accept-proxy ssl crt {{ haproxy_cert_dir }} alpn h2,http/1.1,h3 allow-0rtt
    acl h2 ssl_fc_alpn -i h2
    acl h3 ssl_fc_alpn -i h3
    tcp-request inspect-delay 5s
    tcp-request content accept if HTTP h2
    # ssl_fc: TLS already terminated on this frontend → second hop is post-TLS plain.
    use_backend to_httpmode_from_tls if { ssl_fc } h2
    use_backend to_httpmode_from_tls if { ssl_fc } h3
    use_backend to_httpmode if h2
    use_backend to_httpmode if h3

    #use_backend %[req.hdr(host),map_dom({{ include_path(ctx, 'haproxy/server/maps/http_domain') }})] if { req.hdr(host),map_dom({{ include_path(ctx, 'haproxy/server/maps/http_domain') }}) -m found }
    #use_backend %[req.hdr(x-api-key),map_str({{ include_path(ctx, 'haproxy/server/maps/token_header') }})] if { req.hdr(x-api-key),map_str({{ include_path(ctx, 'haproxy/server/maps/token_header') }}) -m found }
    #use_backend %[path,map_beg({{ include_path(ctx, 'haproxy/server/maps/path_v10') }})] if { path,map_beg({{ include_path(ctx, 'haproxy/server/maps/path_v10') }}) -m found }

    use_backend to_httpmode_from_tls if { ssl_fc }
    default_backend to_httpmode
