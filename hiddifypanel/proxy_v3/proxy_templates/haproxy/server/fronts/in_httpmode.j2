# =====================
# HTTP/2 Frontend
# =====================

frontend in-httpmode-ssl
  # there is a bug in haproxy or xray in which when http/1.1 is set it send alpn as h2 and therefore it makes a confusion for haproxy in http mode so i seperate them
  # rpxy-l4 (L4 SNI mux) does not terminate TLS: it forwards the TLS bytes here. HAProxy
  # terminates TLS on :901, then the second hop is plain HTTP — use to_httpmode_from_tls so
  # in-httpmode does not treat that hop as client cleartext (ssl_fc is false there).
  mode tcp
  bind 127.0.0.1:901 accept-proxy allow-0rtt ssl crt {{ haproxy_cert_dir }} alpn h2,http/1.1
  tcp-request inspect-delay 500ms
  tcp-request content accept if HTTP
  use_backend %[path,map_beg({{ include_path(ctx, 'haproxy/server/maps/path_tcp')}},to_httpmode_from_tls)]
  default_backend to_httpmode_from_tls

frontend in-reality-tcpmode
  bind abns@tcp_in_reality_h1 accept-proxy
  bind :80{% if ctx.hconfig.ipv6_enabled %},:::80 v4v6{% endif %} tfo
  mode tcp
  tcp-request inspect-delay 500ms
  tcp-request content accept if HTTP
  use_backend %[path,map_beg({{ include_path(ctx, 'haproxy/server/maps/path_tcp')}},to_httpmode)]
  
  default_backend to_httpmode


frontend in-httpmode
  # hop_clear: true client cleartext (:80 / reality). hop_from_tls: plain HTTP after an
  # earlier HAProxy TLS terminator (:901). The SSL/QUIC binds terminate TLS on this frontend.
  bind abns@http_in_h2 accept-proxy name hop_clear
  bind abns@http_in_from_tls accept-proxy name hop_from_tls
  bind abns@https_in_http_mode accept-proxy allow-0rtt ssl crt {{ haproxy_cert_dir }} alpn h2,http/1.1
  #bind quic4@:{{ port }},quic6@:{{ port }} v4v6 tfo ssl crt {{ haproxy_cert_dir }} alpn h3
  bind quic4@127.0.0.1:902 ssl crt {{ haproxy_cert_dir }} alpn h3

  mode http

  acl client_clear so_name hop_clear

  # ACME HTTP-01 challenges (panel: hiddifypanel/acme/challenges.py fills this in-memory map only while an order is
  # pending): answered here, before any routing, for every domain and IP — including hosts in http_domain
  # (anytls/naive/hysteria/… SNI decoys). If this ran after map_dom, those hosts would miss the challenge.
  http-request return status 200 content-type text/plain lf-string "%[path,map_str(virt@acme_challenges)]" if { path,map_str(virt@acme_challenges) -m found }
  http-request redirect location %[path,map_str(virt@short_links)] code 302 if { path,map_str(virt@short_links) -m found }

  http-request set-var(txn.backend) str(default_decoy)
  http-request set-var(txn.backend) path,map_beg({{ include_path(ctx, 'haproxy/server/maps/path_v10') }},default_decoy)
  http-request set-var(txn.backend) req.hdr(x-api-key),map_str({{ include_path(ctx, 'haproxy/server/maps/token_header') }},default_decoy) if { req.hdr(x-api-key) -m found } { var(txn.backend) -m str default_decoy }
  http-request set-var(txn.naive_pass) req.hdr(Proxy-Authorization),field(2," "),b64dec,field(2,":") if { req.hdr(Proxy-Authorization) -m found } { var(txn.backend) -m str default_decoy }
  http-request set-var(txn.backend) var(txn.naive_pass),map_str({{ include_path(ctx, 'haproxy/server/maps/token_header') }},default_decoy) if { var(txn.naive_pass) -m found }
  http-request set-var(txn.backend) req.hdr(host),map_dom({{ include_path(ctx, 'haproxy/server/maps/http_domain') }},default_decoy) if { var(txn.backend) -m str default_decoy }


  # Nothing above took the request: the decoy. Cleartext goes to https first; over TLS, a Host other than the TLS SNI
  # (domain fronting) gets the plain "421 Misdirected Request" any server answers, not the decoy.
  acl to_decoy var(txn.backend) -m str default_decoy
  # A CDN that ends the user's TLS and comes in on :80 (Cloudflare "Flexible") says so in these headers: a redirect
  # to https would come back here on :80 again (ERR_TOO_MANY_REDIRECTS). Nothing to gain from faking them: the
  # request is then only answered in cleartext, as asked.
  acl ssl_forwarded req.hdr(x-forwarded-proto) -i https
  acl ssl_forwarded req.hdr(cf-visitor) -m sub "https"
  http-request redirect scheme https code 301 if client_clear !ssl_forwarded { var(txn.backend) -m str panel }
  http-request redirect scheme https code 301 if client_clear !ssl_forwarded to_decoy
  http-request set-var(txn.sni) ssl_fc_sni,lower if to_decoy { ssl_fc }
  http-request set-var(txn.sni) fc_pp_authority,lower if to_decoy { so_name hop_from_tls } { fc_pp_authority -m found }
  http-request set-var(txn.req_host) req.hdr(host),field(1,:),lower if to_decoy
  http-request return status 421 content-type "text/html" hdr cache-control "no-cache" string "<html><body><h1>421 Misdirected Request</h1>\nRequest sent to a non-authoritative server.\n</body></html>\n" if to_decoy { var(txn.sni) -m found } !{ var(txn.sni),strcmp(txn.req_host) eq 0 }

  http-after-response set-header Alt-Svc 'h3=":443"; ma=2592000'

  use_backend %[var(txn.backend)] 

  default_backend default_decoy
