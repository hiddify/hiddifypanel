# =====================
# HTTP/2 Frontend
# =====================
frontend in-httpmode
  bind abns@http_in_h2 accept-proxy allow-0rtt
  bind abns@https_in_http_mode accept-proxy allow-0rtt ssl crt /opt/hiddify-manager/ssl/ alpn h3,h2,http/1.1
  mode http

  http-request set-var(txn.backend) req.hdr(host),map_dom({{ include_path('haproxy/server/maps/http_domain') }},default)
  http-request set-var(txn.backend) req.hdr(x-api-key),map_str({{ include_path('haproxy/server/maps/token_header') }},default) if { var(txn.backend) -m str default }
  http-request set-var(txn.backend) path,map_beg({{ include_path('haproxy/server/maps/path_v10') }},nginx_dispatcher_http_h2) if { var(txn.backend) -m str default }

  
  use_backend %[var(txn.backend)]
  default_backend nginx_dispatcher_http_h2
