# Panel-only domains (HTTP)
{% for d in domains if d['mode'] == 'sub_link_only' %}
{{ d['domain'] }} to_panel_only
{% endfor %}

# Special per-domain port backends — HTTP decoy
{% for d in domains if d['internal_port_special'] %}
{{ d['domain'] }} sp_{{ d['mode'] }}_http_{{ d['internal_port_special'] }}
{% endfor %}

# SNI gateway proxy HTTP decoy domains.
# The decoy backend name is {tag}_decoy_http.
{% for proxy in custom_proxies if proxy.enable and proxy.server_tag %}
{% if proxy.mode == 'domains_sni_gateway' and proxy.server_tag %}
{% set sni_domains = [] %}
{% for domain in sni_domains %}
{{ domain }} {{ proxy.server_tag }}_decoy_http
{% endfor %}
{% endif %}
{% endfor %}
