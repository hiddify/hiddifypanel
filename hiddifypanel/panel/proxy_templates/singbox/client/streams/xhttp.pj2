"transport": {
  "type": "xhttp",
  "path": "{{ proxy.path }}",
  "host": "{{ domain.host }}",
  "mode": "{{ proxy.xhttp_mode | default('auto') }}",
  "headers": {}{% if domain.download and proxy.download_alpn %},
  "downloadSettings": {
    "path": "{{ proxy.path }}",
    "host": "{{ domain.download.server }}",
    "headers": {},
    "tls": {
      "enabled": {{ "true" if proxy.download_alpn.startswith('tls_') else "false" }},
      "server_name": "{{ domain.download.sni }}",
      "insecure": {% if domain.download.allow_insecure %}true{% else %}false{% endif %}{% if proxy.download_alpn.startswith('tls_') %},
      "alpn": [{% for alpn in proxy.download_alpn_list %}
        "{{ alpn }}"{% if not loop.last %},{% endif %}
      {% endfor %}]{% endif %}
    }
  }{% endif %}
}
