{% skip() if not hconfig.shadowtls_enable %}
"type": "shadowtls",
{% include 'hiddify-core/server/snippets/listen' %},
"version": 3,
"users": [
  {"password": "{{ hconfig.shared_secret }}"}
],
"handshake": {
  "server": "{{ domain.sni }}",
  "server_port": 443
},
"handshake_for_server_name": {
  "{{ domain.sni }}": {
    "server": "{{ domain.sni}}",
    "server_port": 443
  }
},
"strict_mode": false
