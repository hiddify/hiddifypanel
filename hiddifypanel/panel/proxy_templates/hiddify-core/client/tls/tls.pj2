"tls": {
  "enabled": true,
  "engine": "{{ hconfig.singbox_tls_engine }}",
  "disable_sni": {{ "false" if domain.sni else "true"}},
  "server_name": "{{ domain.sni }}",
  "insecure": {% if domain.insecure %}false{% else %}true{% endif %},
  "alpn": [{% for alpn in alpns %}
      "{{alpn}}",
      {%endfor%}
  ],
  "certificate": "",
  "certificate_public_key_sha256": [
    {% for pin in domain.cert.pinnedPeerCertSha256 %}
    "{{ pin }}",
    {% endfor %}
  ],
  {% if hconfig.tls_ech_enable %}
  "ech": {
    "enabled": true,
    "config": [],
    "config_path": "",
    "query_server_name": "{{ domain.sni }}"
  },
  {% endif %}
  "utls": {
    "enabled": {%if hconfig.fingerprint %}true{%else %}false{%endif%},
    "fingerprint": "{{hconfig.fingerprint}}"
  }
},
