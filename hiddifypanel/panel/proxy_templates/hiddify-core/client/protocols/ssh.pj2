{% skip() if not hconfig.ssh_server_enable %}
"type": "ssh",
"server": "{{ proxy.server }}",
"server_port": {{ proxy.port }},
"user": "{{ user.uuid }}",
"private_key": "{{ user.ed25519_private_key }}",
"host_key": [
  "{{ hconfig.ssh_host_rsa_pub | replace('\n', '\\n') }}",
  "{{ hconfig.ssh_host_ecdsa_pub | replace('\n', '\\n') }}",
  "{{ hconfig.ssh_host_ed25519_pub | replace('\n', '\\n') }}"
],
