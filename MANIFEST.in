include LICENSE
include HISTORY.md
include Containerfile
graft tests
graft hiddifypanel
graft hiddifypanel/static
include hiddifypanel/static
global-include  */templates/*

#exclude hiddifypanel/base2.c
#exclude hiddifypanel/base2.pyx
global-exclude *.pyx
global-exclude *.c
global-exclude */__pycache__/*
global-include *.so

# admin_v2 is the Vue frontend's build-time source only: vite writes the shipped
# assets to hiddifypanel/static/admin-v2/. Without this, `graft hiddifypanel`
# above sweeps its node_modules (271MB) into the sdist and wheel.
prune hiddifypanel/admin_v2
