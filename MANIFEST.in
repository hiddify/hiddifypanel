include LICENSE
include HISTORY.md
include Containerfile
graft tests
graft hiddifypanel
graft hiddifypanel/static
include hiddifypanel/static
global-include  */templates/*

#exclude hiddifypanel/base2.c
#exclude hiddifypanel/base2.pyx
global-exclude *.pyx
global-exclude *.c
global-exclude */__pycache__/*
global-include *.so

# admin_v2 / user_front are frontend build-time sources only: vite writes the
# shipped assets to hiddifypanel/static/admin-v2/ and static/user-front/. Without this,
# `graft hiddifypanel` would sweep their node_modules into the sdist and wheel.
prune hiddifypanel/admin_v2
prune hiddifypanel/user_front
